// ============================================================================
// PayMix - 간편결제 시대의 카드 최적 배치 서비스
// 데이터 모델 (ERD)
//
//   3반 P074 박수빈
//
//   [설계 원칙]
//   1) 제안 범위는 고객이 이미 보유한 자사 카드 내 재배치로 한정한다.
//   2) 모든 혜택 수치는 서버 규칙 엔진이 산출한다. AI는 확정 수치를 설명만 한다.
//   3) 채널 인정률은 카드 속성도 채널 속성도 아닌 (카드 x 채널) 교차 속성이므로
//      card_channel_rates 로 분리한다.
//   4) 제안 상세는 규칙 참조가 아니라 계산 시점 스냅샷으로 보관한다.
//
//   [핵심 산출 로직 - 각 컬럼 note 에서 로직 번호로 참조]
//   (1) 인정실적 = SUM(결제액 x 카테고리인정률 x 채널인정률)
//   (2) 실적 구간 판정 -> 적용 혜택 세트 확정
//   (3) 실효혜택 = MIN( SUM( MIN(결제액 x 할인율, 항목월한도) ), 통합월한도 )
//   (4) 연간 순이익 = ((실효혜택 + 채널적립) x 12) - 연회비
//   (5) 최적 배치 = (페이채널 x 보유카드), (정기결제 x 보유카드) 조합 중 순이익 최대
// ============================================================================


// ============================================================================
// Enum - 상태값 및 구분값 정의
// ============================================================================

Enum UserRole {
  CUSTOMER        [note: '고객 - 카드 연결, 진단 조회, 개선 제안 확인']
  ISSUER_MANAGER  [note: '카드사 담당자 - 채널 분석, 정책 시뮬레이션, 규칙 관리']
}

Enum ChannelType {
  PHYSICAL    [note: '실물카드 결제 - 채널 인정률 기본 100%']
  MOBILE_PAY  [note: '단말 기반 간편결제 (삼성페이, 애플페이 등)']
  ONLINE_PAY  [note: '온라인 간편결제 (네이버페이, 카카오페이 등)']
}

Enum BenefitType {
  DISCOUNT  [note: '청구 할인']
  POINT     [note: '포인트 적립']
}

Enum TransactionStatus {
  APPROVED  [note: '승인 완료 - 실적 및 혜택 산출 대상']
  CANCELED  [note: '승인 취소 - 산출에서 제외']
}

Enum BillingCycle {
  MONTHLY  [note: '월 단위 정기결제']
  YEARLY   [note: '연 단위 정기결제 - 월 환산하여 산출']
}

Enum SubscriptionStatus {
  ACTIVE    [note: '결제 진행 중']
  PAUSED    [note: '일시 중지']
  CANCELED  [note: '해지']
}

Enum RecommendationStatus {
  PENDING           [note: '제안 생성됨 - 고객 확인 전']
  ACCEPTED          [note: '고객이 제안을 수락함 - 제안 수락률 지표 산출 근거']
  DISMISSED         [note: '고객이 제안을 보류함']
  NO_CHANGE_NEEDED  [note: '현재 배치가 이미 최적 - 변경 실익 없음 (화면 5 예외 시나리오)']
}

Enum RecommendationType {
  CHANNEL_REASSIGN   [note: '페이 채널별 권장 카드 재배치']
  SUBSCRIPTION_MOVE  [note: '정기결제 결제카드 이전']
  TIER_GAP           [note: '실적 구간 근접 안내 - 소액 추가 결제로 상위 구간 도달']
}


// ============================================================================
// 1. 계정 및 고객 (화면 1: 로그인/회원가입, 화면 2: 카드 데이터 연결)
// ============================================================================

Table users {
  id bigint [pk, increment, note: 'PK']
  email varchar(255) [not null, unique, note: '로그인 계정 - 이메일 형식']
  password_hash varchar(255) [not null, note: '암호화된 비밀번호 (BCrypt)']
  name varchar(50) [not null, note: '사용자 실명']
  role UserRole [not null, note: '액터 구분 - 로그인 후 진입 화면을 결정 (고객: 화면 2, 카드사: 화면 6)']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  Note: '계정 정보. 고객과 카드사 담당자를 role 로 구분한다.'
}

Table customers {
  id bigint [pk, increment, note: 'PK']
  user_id bigint [not null, unique, note: 'FK -> users.id (1:1)']
  birth_year int [note: '출생연도 - 카드사 세그먼트 추출 조건 (화면 7)']
  joined_at date [not null, note: '카드사 가입일. 현재일과의 차이가 1개월 미만이면 진단 불가 처리 (화면 3 예외 시나리오)']
  created_at timestamp [not null, default: `now()`]

  Note: '고객 프로필. joined_at 이 진단 가능 여부 판정 기준이다.'
}


// ============================================================================
// 2. 카드 상품 및 보유 카드 (화면 2, 화면 8)
// ============================================================================

Table cards {
  id bigint [pk, increment, note: 'PK']
  card_code varchar(30) [not null, unique, note: '카드 상품 코드 (예: PM-PLATINUM)']
  name varchar(100) [not null, note: '카드 상품명']
  brand varchar(20) [note: '국제 브랜드 (VISA, MASTER 등)']
  annual_fee int [not null, default: 0, note: '연회비(원) - 산출로직 (4) 연간 순이익 차감 항목']
  total_monthly_benefit_limit int [note: '카드 전체 통합 월 한도(원) - 산출로직 (3) 최종 상한. NULL 이면 무제한']
  description varchar(500) [note: '상품 설명 - 화면 2 카드 선택 시 노출']
  image_url varchar(500) [note: '카드 이미지 경로']
  is_active boolean [not null, default: true, note: '판매 중지 시 false - 신규 연결 불가']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  Note: '자사 카드 상품 마스터. 타사 카드는 등록하지 않는다 (범위 원칙 1).'
}

Table customer_cards {
  id bigint [pk, increment, note: 'PK']
  customer_id bigint [not null, note: 'FK -> customers.id']
  card_id bigint [not null, note: 'FK -> cards.id']
  masked_number varchar(25) [not null, note: '마스킹 카드번호 (예: 1234-****-****-5678) - 화면 2/3 카드 식별 표기']
  card_alias varchar(50) [note: '고객이 지정한 카드 별칭']
  is_linked boolean [not null, default: true, note: '연결 상태. 해제 시 false (화면 2)']
  linked_at timestamp [not null, default: `now()`, note: '카드 데이터 연결 시각']
  last_synced_at timestamp [note: '결제 데이터 최종 동기화 시각 - 화면 2 동기화 버튼 결과']
  created_at timestamp [not null, default: `now()`]

  indexes {
    (customer_id, card_id, masked_number) [unique, name: 'uq_customer_card']
    customer_id [name: 'idx_customer_cards_customer']
  }

  Note: '고객이 보유한 자사 카드. 제안(최적 배치) 탐색의 후보 집합이 된다.'
}

Table point_balances {
  id bigint [pk, increment, note: 'PK']
  customer_card_id bigint [not null, unique, note: 'FK -> customer_cards.id (1:1)']
  balance int [not null, default: 0, note: '포인트 잔액(P) - 화면 3 노출'] 
  expiring_amount int [not null, default: 0, note: '3개월 내 소멸 예정 포인트(P) - 화면 3 경고 표기']
  expiring_at date [note: '가장 가까운 소멸 예정일']
  updated_at timestamp [not null, default: `now()`]

  Note: '보유 카드별 포인트 현황. 화면 3(실적·연회비 진단)의 포인트 영역을 지원한다.'
}


// ============================================================================
// 3. 결제 채널 / 소비 카테고리 (기준 정보)
// ============================================================================

Table pay_channels {
  id bigint [pk, increment, note: 'PK']
  code varchar(30) [not null, unique, note: '채널 코드 (PHYSICAL, SAMSUNG_PAY, NAVER_PAY, KAKAO_PAY 등)']
  name varchar(50) [not null, note: '채널명 (실물카드, 삼성페이, 네이버페이 ...)']
  channel_type ChannelType [not null, note: '채널 유형']
  reward_rate decimal(5,4) [not null, default: 0, note: '채널 자체 적립률 (0~1) - 산출로직 (4) 채널적립. 카드 혜택과 별개로 페이사가 지급']
  logo_url varchar(500) [note: '채널 로고 경로 - 화면 4/5/6 표기']
  is_active boolean [not null, default: true]

  Note: '간편결제 채널 마스터. 실물카드도 하나의 채널로 취급해 동일 로직으로 비교한다.'
}

Table spending_categories {
  id bigint [pk, increment, note: 'PK']
  code varchar(30) [not null, unique, note: '카테고리 코드 (FOOD, TELECOM, UTILITY, SUBSCRIPTION 등)']
  name varchar(50) [not null, note: '카테고리명 (외식, 통신비, 공과금, 구독 ...)']
  default_performance_rate decimal(5,4) [not null, default: 1, note: '기본 카테고리 인정률 (0~1) - 산출로직 (1). 공과금/통신비 자동이체 등은 0']
  is_excluded_by_default boolean [not null, default: false, note: 'true 이면 실적 제외 카테고리 - 화면 3 실적 제외 내역에 사유와 함께 노출']
  display_order int [not null, default: 0, note: '화면 정렬 순서']

  Note: '소비 카테고리 마스터. 인정률이 0 인 카테고리가 정기결제 사각지대의 원인이다.'
}


// ============================================================================
// 4. 혜택 규칙 (화면 8: 카드·혜택 규칙 관리 / 화면 7: 시뮬레이션 대상)
// ============================================================================

Table card_performance_tiers {
  id bigint [pk, increment, note: 'PK']
  card_id bigint [not null, note: 'FK -> cards.id']
  tier_level int [not null, note: '구간 레벨. 0 = 실적 미달, 1 이상 = 충족 구간 (숫자가 클수록 상위)']
  tier_name varchar(50) [not null, note: '구간 표시명 (예: 30만원 이상)']
  min_performance int [not null, note: '구간 하한 인정실적(원) - 산출로직 (2) 판정 기준']
  max_performance int [note: '구간 상한 인정실적(원). NULL 이면 상한 없음']

  indexes {
    (card_id, tier_level) [unique, name: 'uq_card_tier_level']
  }

  Note: '카드별 전월실적 구간. 구간에 따라 적용되는 benefit_rules 세트가 달라진다.'
}

Table benefit_rules {
  id bigint [pk, increment, note: 'PK']
  card_id bigint [not null, note: 'FK -> cards.id']
  category_id bigint [not null, note: 'FK -> spending_categories.id']
  tier_id bigint [not null, note: 'FK -> card_performance_tiers.id - 이 규칙이 적용되는 실적 구간']
  benefit_type BenefitType [not null, note: '혜택 유형 (할인 / 적립)']
  rate decimal(5,4) [not null, note: '할인율 또는 적립률 (0~1) - 산출로직 (3)']
  per_transaction_limit int [note: '건당 한도(원). NULL 이면 무제한']
  monthly_item_limit int [note: '항목별 월 한도(원) - 산출로직 (3) 1차 상한. NULL 이면 무제한']
  min_transaction_amount int [not null, default: 0, note: '혜택 적용 최소 결제금액(원)']
  is_active boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    (card_id, category_id, tier_id) [unique, name: 'uq_benefit_rule']
  }

  Note: '카드 x 카테고리 x 실적구간 단위 혜택 규칙. 건당/항목월/통합월 3종 한도가 중첩 적용된다.'
}

Table card_channel_rates {
  id bigint [pk, increment, note: 'PK']
  card_id bigint [not null, note: 'FK -> cards.id']
  channel_id bigint [not null, note: 'FK -> pay_channels.id']
  performance_rate decimal(5,4) [not null, default: 1, note: '채널 인정률 (0~1) - 산출로직 (1). 실물 1.0, 간편결제는 카드사 정책에 따라 0~1']
  is_benefit_eligible boolean [not null, default: true, note: 'false 이면 해당 채널 결제에 카드 혜택 자체를 적용하지 않음']
  effective_from date [not null, note: '정책 적용 시작일 - 인정률 변경 이력 보존']
  updated_by bigint [note: 'FK -> users.id - 화면 8 에서 인정률을 수정한 카드사 담당자']
  updated_at timestamp [not null, default: `now()`]

  indexes {
    (card_id, channel_id, effective_from) [unique, name: 'uq_card_channel_effective']
  }

  Note: '★ 설계 핵심. 채널 인정률은 카드 속성도 채널 속성도 아닌 (카드 x 채널) 교차 속성이다. 이 분리가 카드사별 채널 차등 정책과 화면 7 시뮬레이션의 구현 가능 여부를 결정한다.'
}


// ============================================================================
// 5. 거래 및 정기결제 (외부 액터 수신 + 산출 원천 데이터)
// ============================================================================

Table transactions {
  id bigint [pk, increment, note: 'PK']
  customer_card_id bigint [not null, note: 'FK -> customer_cards.id']
  channel_id bigint [not null, note: 'FK -> pay_channels.id - 어느 채널을 경유했는지']
  category_id bigint [not null, note: 'FK -> spending_categories.id - 업종 정규화 결과로 매핑']
  subscription_id bigint [note: 'FK -> subscriptions.id. 정기결제 건이면 연결, 일반 결제면 NULL']
  external_tx_id varchar(64) [not null, unique, note: '결제 승인계 원 거래 ID - 중복 수신 방지(멱등성 키)']
  merchant_name varchar(200) [not null, note: '원본 가맹점명. 간편결제/PG 경유 시 식별 불가한 형태로 들어옴']
  normalized_merchant varchar(200) [note: 'AI 업종 정규화 결과 가맹점명. 정규화 실패 시 NULL 이며 혜택 산출에서 제외']
  amount int [not null, note: '승인 금액(원) - 산출로직 (1)(3) 의 결제액']
  approved_at timestamp [not null, note: '승인 일시 - 월별 집계 기준']
  status TransactionStatus [not null, default: 'APPROVED', note: 'CANCELED 건은 모든 산출에서 제외']
  created_at timestamp [not null, default: `now()`]

  indexes {
    (customer_card_id, approved_at) [name: 'idx_tx_card_date']
    (channel_id, approved_at) [name: 'idx_tx_channel_date']
  }

  Note: '거래 내역. 외부 액터(결제 승인계)가 POST /external/transactions 로 송신하며, 인정실적/실효혜택/채널비중 전 계산의 원천이 된다.'
}

Table subscriptions {
  id bigint [pk, increment, note: 'PK']
  customer_id bigint [not null, note: 'FK -> customers.id']
  customer_card_id bigint [not null, note: 'FK -> customer_cards.id - 현재 결제되고 있는 카드']
  category_id bigint [not null, note: 'FK -> spending_categories.id']
  merchant_name varchar(200) [not null, note: '정기결제 서비스명 (넷플릭스, 통신사 등)']
  amount int [not null, note: '회차당 결제 금액(원)']
  billing_cycle BillingCycle [not null, default: 'MONTHLY', note: '결제 주기. YEARLY 는 12 로 나눠 월 환산 후 산출']
  billing_day int [note: '결제일 (1~31)']
  status SubscriptionStatus [not null, default: 'ACTIVE', note: 'ACTIVE 건만 제안 대상']
  deep_link_url varchar(500) [note: '결제수단 변경 페이지 딥링크. 자동 변경은 범위 밖이며 안내까지만 제공']
  started_at date [note: '정기결제 시작일']
  updated_at timestamp [not null, default: `now()`]

  indexes {
    customer_id [name: 'idx_subscriptions_customer']
  }

  Note: '정기결제. 카테고리 인정률이 0 인 경우가 많아 실적 사각지대이자 최적화 여지가 가장 큰 영역이다.'
}


// ============================================================================
// 6. 개선 제안 (화면 5)
// ============================================================================

Table recommendations {
  id bigint [pk, increment, note: 'PK']
  customer_id bigint [not null, note: 'FK -> customers.id']
  base_month char(7) [not null, note: '산출 기준월 (YYYY-MM)']
  status RecommendationStatus [not null, default: 'PENDING', note: 'annual_gain 이 0 이면 NO_CHANGE_NEEDED 로 저장 (화면 5 예외 시나리오)']
  current_annual_net_benefit int [not null, note: '현재 배치 기준 연간 순이익(원) - 산출로직 (4)']
  optimized_annual_net_benefit int [not null, note: '최적 배치 기준 연간 순이익(원) - 산출로직 (5)']
  annual_gain int [not null, note: '연간 개선액 = optimized - current. 0 이면 변경 실익 없음']
  explanation text [note: 'AI 생성 자연어 설명. 수치는 규칙 엔진 확정값이며 AI 는 설명만 담당한다']
  calculated_at timestamp [not null, default: `now()`, note: '산출 시각 - 스냅샷 기준 시점']
  accepted_at timestamp [note: '고객이 제안을 수락한 시각. 제안 수락률 지표 산출 근거']

  indexes {
    (customer_id, base_month) [name: 'idx_reco_customer_month']
  }

  Note: '제안 실행 이력. 헤더 레벨 요약값을 보관한다.'
}

Table recommendation_details {
  id bigint [pk, increment, note: 'PK']
  recommendation_id bigint [not null, note: 'FK -> recommendations.id']
  detail_type RecommendationType [not null, note: '제안 유형']
  channel_id bigint [note: 'FK -> pay_channels.id - CHANNEL_REASSIGN 일 때 대상 채널']
  subscription_id bigint [note: 'FK -> subscriptions.id - SUBSCRIPTION_MOVE 일 때 대상 정기결제']
  current_customer_card_id bigint [note: 'FK -> customer_cards.id - 현재 배치된 카드. 미배치면 NULL']
  suggested_customer_card_id bigint [not null, note: 'FK -> customer_cards.id - 권장 카드 (반드시 고객 보유 자사 카드)']
  snapshot_card_name varchar(100) [not null, note: '★ 스냅샷: 계산 시점 권장 카드명']
  snapshot_channel_rate decimal(5,4) [note: '★ 스냅샷: 계산 시점 채널 인정률']
  snapshot_benefit_rate decimal(5,4) [note: '★ 스냅샷: 계산 시점 적용 할인/적립률']
  snapshot_monthly_limit int [note: '★ 스냅샷: 계산 시점 적용 월 한도(원)']
  current_monthly_benefit int [not null, note: '현재 배치의 월 혜택(원)']
  suggested_monthly_benefit int [not null, note: '권장 배치의 월 혜택(원)']
  monthly_gain int [not null, note: '월 개선액 = suggested - current']
  reason varchar(300) [not null, note: '근거 요약 문구 - 화면 5 차분 비교 표에 노출']
  display_order int [not null, default: 0]

  indexes {
    recommendation_id [name: 'idx_reco_detail_parent']
  }

  Note: '★ 설계 핵심. 혜택 규칙은 변경되므로 규칙 FK 참조만으로는 과거 제안의 근거가 소실된다. 따라서 계산 시점의 인정률/할인율/한도를 snapshot_* 컬럼에 값으로 복사해 보관한다.'
}


// ============================================================================
// Relationships
// ============================================================================

// 계정 및 고객
Ref: customers.user_id - users.id                              // 1:1

// 보유 카드
Ref: customer_cards.customer_id > customers.id                 // 1:N
Ref: customer_cards.card_id > cards.id                         // 1:N
Ref: point_balances.customer_card_id - customer_cards.id       // 1:1

// 혜택 규칙
Ref: card_performance_tiers.card_id > cards.id                 // 1:N
Ref: benefit_rules.card_id > cards.id                          // 1:N
Ref: benefit_rules.category_id > spending_categories.id        // 1:N
Ref: benefit_rules.tier_id > card_performance_tiers.id         // 1:N

// 카드 x 채널 교차 (M:N 해소 엔티티)
Ref: card_channel_rates.card_id > cards.id                     // 1:N
Ref: card_channel_rates.channel_id > pay_channels.id           // 1:N
Ref: card_channel_rates.updated_by > users.id                  // 1:N

// 거래
Ref: transactions.customer_card_id > customer_cards.id         // 1:N
Ref: transactions.channel_id > pay_channels.id                 // 1:N
Ref: transactions.category_id > spending_categories.id         // 1:N
Ref: transactions.subscription_id > subscriptions.id           // 1:N (nullable)

// 정기결제
Ref: subscriptions.customer_id > customers.id                  // 1:N
Ref: subscriptions.customer_card_id > customer_cards.id        // 1:N
Ref: subscriptions.category_id > spending_categories.id        // 1:N

// 제안
Ref: recommendations.customer_id > customers.id                // 1:N
Ref: recommendation_details.recommendation_id > recommendations.id                 // 1:N
Ref: recommendation_details.channel_id > pay_channels.id                           // 1:N (nullable)
Ref: recommendation_details.subscription_id > subscriptions.id                     // 1:N (nullable)
Ref: recommendation_details.current_customer_card_id > customer_cards.id           // 1:N (nullable)
Ref: recommendation_details.suggested_customer_card_id > customer_cards.id         // 1:N
